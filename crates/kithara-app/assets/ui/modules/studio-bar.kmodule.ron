(
    schema: "kithara.module",
    version: 1,
    id: "studio-bar",
    root: Row(
        gap: 0.0,
        pad: 0.0,
        children: [
            Brand(id: "brand"),
            Divider(id: "after-brand"),
            Row(
                id: "layout",
                gap: 0.0,
                pad: 12.0,
                size: (w: Fixed(80.0), h: Fill),
                children: [
                    Segmented(
                        id: "decks",
                        size: (w: Fill, h: Fixed(26.0)),
                        items: ["1", "2"],
                        read: Parameter(id: "ui.layout.decks"),
                        write: Parameter(id: "ui.layout.decks"),
                    ),
                ],
            ),
            Divider(id: "after-layout"),
            TitleBar(id: "title", label: "KITHARA STUDIO"),
            WindowDrag(id: "drag"),
            Divider(id: "before-master"),
            Row(
                id: "master",
                gap: 8.0,
                pad: 11.0,
                size: (w: Shrink, h: Fill),
                children: [
                    Text(id: "master-label", style: MicroLabel, label: "MASTER"),
                    VuStereo(
                        id: "master-vu",
                        size: (w: Fixed(72.0), h: Fixed(20.0)),
                        read: Telemetry(id: "player.output.levels"),
                    ),
                ],
            ),
            Divider(id: "before-cpu"),
            Row(
                id: "cpu",
                gap: 6.0,
                pad: 11.0,
                size: (w: Shrink, h: Fill),
                children: [
                    Text(id: "cpu-label", style: MicroLabel, label: "CPU"),
                    Meter(id: "cpu-bar", read: Telemetry(id: "engine.load")),
                    Scalar(
                        id: "cpu-value",
                        size: (w: Shrink, h: Fill),
                        format: Percent,
                        framed: false,
                        read: Telemetry(id: "engine.load"),
                    ),
                ],
            ),
            Divider(id: "before-broadcast"),
            Pressable(
                id: "broadcast",
                press: Command(id: "broadcast.toggle"),
                child: Row(
                    id: "broadcast-cell",
                    gap: 6.0,
                    pad: 11.0,
                    size: (w: Shrink, h: Fill),
                    children: [
                        StatusDot(
                            id: "broadcast-dot",
                            label: "REC",
                            tone: Neutral,
                            size: (w: Shrink, h: Fill),
                            active: Telemetry(id: "broadcast.on_air"),
                            active_tone: Danger,
                        ),
                    ],
                ),
            ),
            Divider(id: "before-presets"),
            Row(
                id: "presets",
                gap: 0.0,
                pad_x: 8.0,
                size: (w: Shrink, h: Fill),
                children: [
                    PresetSelector(id: "preset"),
                    Spacer(id: "preset-gap", size: (w: Fixed(8.0), h: Fill)),
                    Include(id: "settings", source: "studio-settings.kmodule.ron"),
                ],
            ),
            Divider(id: "before-window"),
            WindowControls(id: "window", style: Standard),
        ],
    ),
)
