(
    schema: "kithara.module",
    version: 1,
    id: "app-bar",
    root: Row(
        gap: 0.0,
        pad: 0.0,
        measure: Width,
        size: (w: Fill, h: Fill),
        children: [
            Include(id: "menu", source: "app-menu.kmodule.ron"),
            Reveal(from: 1250.0, child: Row(
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                children: [
                    Brand(id: "brand"),
                    Divider(id: "after-brand"),
                ],
            )),
            WindowDrag(id: "drag"),
            Row(
                id: "host-tempo-group",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                children: [
                    Divider(id: "before-host-tempo"),
                    Row(
                        id: "host-tempo",
                        gap: 6.0,
                        pad: 11.0,
                        size: (w: Shrink, h: Fill),
                        write: Command(id: "tempo.host_step"),
                        children: [
                            Text(id: "host-tempo-label", style: MicroLabel, label: "@bar.host_tempo"),
                            Text(id: "host-tempo-value", style: Section, read: Telemetry(id: "tempo.host")),
                            Text(id: "host-tempo-state", style: Telemetry, read: Telemetry(id: "tempo.host_state")),
                        ],
                    ),
                ],
            ),
            Reveal(from: 1120.0, child: Row(
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                children: [
                    Optional(
                        id: "cpu-block",
                        hidden: Model(id: "ui.module.hidden", with: { "module": "cpu" }),
                        child: Row(
                            id: "cpu-group",
                            gap: 0.0,
                            size: (w: Shrink, h: Fill),
                            children: [
                                Divider(id: "before-cpu"),
                                Row(
                                    id: "cpu",
                                    gap: 6.0,
                                    pad: 11.0,
                                    size: (w: Shrink, h: Fill),
                                    children: [
                                        Text(id: "cpu-label", style: MicroLabel, label: "@bar.cpu"),
                                        Meter(id: "cpu-bar", read: Telemetry(id: "engine.load")),
                                        Scalar(
                                            id: "cpu-value",
                                            size: (w: Shrink, h: Fill),
                                            format: Percent,
                                            framed: false,
                                            read: Telemetry(id: "engine.load"),
                                        ),
                                    ],
                                ),
                            ],
                        ),
                    ),
                ],
            )),
            Optional(
                id: "broadcast-block",
                hidden: Telemetry(id: "broadcast.hidden"),
                child: Row(
                    id: "broadcast-group",
                    gap: 0.0,
                    size: (w: Shrink, h: Fill),
                    children: [
                        Divider(id: "before-broadcast"),
                        Pressable(
                            id: "broadcast",
                            press: Command(id: "broadcast.toggle"),
                            child: Row(
                                id: "broadcast-cell",
                                gap: 6.0,
                                pad: 11.0,
                                size: (w: Shrink, h: Fill),
                                children: [
                                    StatusDot(
                                        id: "broadcast-dot",
                                        label: "@bar.rec",
                                        tone: Neutral,
                                        size: (w: Shrink, h: Fill),
                                        active: Telemetry(id: "broadcast.on_air"),
                                        active_tone: Danger,
                                    ),
                                ],
                            ),
                        ),
                    ],
                ),
            ),
            Optional(
                id: "window-block",
                hidden: Model(id: "ui.window.chrome_hidden", with: { "window": "1" }),
                child: Row(
                    id: "window-group",
                    gap: 0.0,
                    size: (w: Shrink, h: Fill),
                    children: [
                        Divider(id: "before-window"),
                        WindowControls(id: "window", style: Standard),
                    ],
                ),
            ),
        ],
    ),
)
