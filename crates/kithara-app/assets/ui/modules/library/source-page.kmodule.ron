(
    schema: "kithara.module",
    version: 1,
    id: "library-source-page",
    chrome: Plain,
    parameters: ["source"],
    root: Table(
        id: "rows",
        footer: false,
        padding_left: 34.0,
        padding_right: 34.0,
        write_width: Parameter(id: "source.column.width", with: { "source": "$source" }),
        status: Model(id: "source.status", with: { "source": "$source" }),
        read: Model(id: "source.rows", with: { "source": "$source" }),
        write: Command(id: "source.select", with: { "source": "$source" }),
        columns: [
            (id: "index", label: "@track_list.column.index", style: Index, width: 28.0),
            (id: "title", label: "@track_list.column.title", style: Primary, width: 180.0, flexible: true),
            (id: "artist", label: "@track_list.column.artist", style: Secondary, width: 200.0),
            (id: "bpm", label: "@track_list.column.bpm", style: Metric, width: 70.0),
            (id: "key", label: "@track_list.column.key", style: Mono, width: 56.0),
            (id: "time", label: "@track_list.column.time", style: Time, width: 70.0),
        ],
    ),
)
