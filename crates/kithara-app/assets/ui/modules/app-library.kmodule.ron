(
    schema: "kithara.module",
    version: 1,
    id: "app-library",
    root: Row(
        gap: 1.0,
        children: [
            Tree(
                id: "tree",
                size: (w: Fixed(210.0), h: Fill),
                read: Model(id: "library.tree"),
                write: Command(id: "library.select"),
                toggle: Command(id: "library.toggle"),
            ),
            Include(id: "pages", source: "../library-pages.kmodule.ron"),
        ],
    ),
)
