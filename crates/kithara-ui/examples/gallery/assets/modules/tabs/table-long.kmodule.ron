(
    schema: "kithara.module",
    version: 1,
    id: "gallery-table-long-tab",
    root: Column(
        gap: Some(12.0),
        pad: Some(18.0),
        children: [
            Text(
                id: "long-label",
                style: MicroLabel,
                label: "A TRACK LIST TALLER THAN ITS VIEWPORT",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Table(
                id: "table",
                size: (w: Fill, h: Fill),
                read: Model(id: "library.long_tracks"),
                columns: [
                    (id: "index", label: "@track_list.column.index", style: Index, width: 28.0),
                    (id: "deck", label: "@track_list.column.deck", style: Badge, width: 64.0),
                    (id: "title", label: "@track_list.column.title", style: Primary, width: 220.0, flexible: true),
                    (id: "artist", label: "@track_list.column.artist", style: Secondary, width: 200.0),
                    (id: "bpm", label: "@track_list.column.bpm", style: Metric, width: 70.0),
                    (id: "key", label: "@track_list.column.key", style: Mono, width: 56.0),
                    (id: "time", label: "@track_list.column.time", style: Time, width: 70.0),
                    (id: "energy", label: "@track_list.column.energy", style: Meter, width: 110.0),
                ],
            ),
        ],
    ),
)
