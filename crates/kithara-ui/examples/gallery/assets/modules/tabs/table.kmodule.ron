(
    schema: "kithara.module",
    version: 1,
    id: "gallery-table-tab",
    root: Column(
        gap: Some(12.0),
        pad: Some(18.0),
        children: [
            Row(
                size: (w: Fill, h: Fixed(26.0)),
                gap: Some(12.0),
                children: [
                    Text(
                        id: "preset-label",
                        style: MicroLabel,
                        label: "COLUMN PRESET",
                        size: (w: Shrink, h: Fixed(26.0)),
                    ),
                    Segmented(
                        id: "column-preset",
                        items: ["LIBRARY", "SET QUEUE", "MICRO"],
                        read: Model(id: "gallery.table.preset"),
                        size: (w: Fixed(420.0), h: Fixed(26.0)),
                    ),
                ],
            ),
            Row(
                size: (w: Fill, h: Fill),
                gap: Some(16.0),
                children: [
                    Table(
                        id: "table",
                        size: (w: Fill, h: Fill),
                        read: Model(id: "library.visible_tracks"),
                        columns: [
                            (id: "index", label: "#", style: Index, width: 28.0),
                            (id: "deck", label: "DECK", style: Badge, width: 64.0),
                            (id: "title", label: "TITLE", style: Primary, width: 180.0, flexible: true),
                            (id: "artist", label: "ARTIST", style: Secondary, width: 200.0),
                            (id: "bpm", label: "BPM", style: Metric, width: 70.0),
                            (id: "key", label: "KEY", style: Mono, width: 56.0),
                            (id: "time", label: "TIME", style: Time, width: 70.0),
                            (id: "energy", label: "ENERGY", style: Meter, width: 110.0),
                            (id: "transition", label: "TRANSITION", style: Transition, width: 130.0),
                        ],
                        columns_state: Some(Model(id: "gallery.table.columns")),
                        adaptive: (priority: Required),
                    ),
                    Column(
                        id: "columns-panel",
                        size: (w: Fixed(200.0), h: Fill),
                        gap: Some(8.0),
                        pad: Some(10.0),
                        children: [
                            Text(
                                id: "columns-label",
                                style: MicroLabel,
                                label: "TABLE COLUMNS",
                                size: (w: Fill, h: Fixed(18.0)),
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-index", read: Model(id: "gallery.table.columns.index")),
                                    Text(id: "column-index-label", style: MicroLabel, label: "#", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-deck", read: Model(id: "gallery.table.columns.deck")),
                                    Text(id: "column-deck-label", style: MicroLabel, label: "DECK", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-title", read: Model(id: "gallery.table.columns.title")),
                                    Text(id: "column-title-label", style: MicroLabel, label: "TITLE", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-artist", read: Model(id: "gallery.table.columns.artist")),
                                    Text(id: "column-artist-label", style: MicroLabel, label: "ARTIST", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-bpm", read: Model(id: "gallery.table.columns.bpm")),
                                    Text(id: "column-bpm-label", style: MicroLabel, label: "BPM", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-key", read: Model(id: "gallery.table.columns.key")),
                                    Text(id: "column-key-label", style: MicroLabel, label: "KEY", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-time", read: Model(id: "gallery.table.columns.time")),
                                    Text(id: "column-time-label", style: MicroLabel, label: "TIME", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-energy", read: Model(id: "gallery.table.columns.energy")),
                                    Text(id: "column-energy-label", style: MicroLabel, label: "ENERGY", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Row(
                                size: (w: Fill, h: Fixed(18.0)),
                                gap: Some(8.0),
                                children: [
                                    Checkbox(id: "column-transition", read: Model(id: "gallery.table.columns.transition")),
                                    Text(id: "column-transition-label", style: MicroLabel, label: "TRANSITION", size: (w: Fill, h: Fill)),
                                ],
                            ),
                            Button(
                                id: "reset-columns",
                                label: "RESET TO DEFAULTS",
                                size: (w: Fill, h: Fixed(26.0)),
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
