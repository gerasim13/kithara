(
    schema: "kithara.module",
    version: 1,
    id: "gallery-module-tabs",
    chrome: Plain,
    root: Row(
        size: (w: Fill, h: Fill),
        background: Bg,
        children: [
            TabLarge(
                id: "deck",
                label: "DECK",
                read: Page(id: "/module", name: "deck"),
                write: Page(id: "/module", name: "deck"),
            ),
            TabLarge(
                id: "deck-micro",
                label: "DECK MICRO",
                read: Page(id: "/module", name: "deck-micro"),
                write: Page(id: "/module", name: "deck-micro"),
            ),
            TabLarge(
                id: "global-bar",
                label: "GLOBAL BAR",
                read: Page(id: "/module", name: "global-bar"),
                write: Page(id: "/module", name: "global-bar"),
            ),
            TabLarge(
                id: "telemetry",
                label: "TELEMETRY",
                read: Page(id: "/module", name: "telemetry"),
                write: Page(id: "/module", name: "telemetry"),
            ),
            TabLarge(
                id: "layout",
                label: "LAYOUT",
                read: Page(id: "/module", name: "layout"),
                write: Page(id: "/module", name: "layout"),
            ),
        ],
    ),
)
