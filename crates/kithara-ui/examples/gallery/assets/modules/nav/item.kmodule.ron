(
    schema: "kithara.module",
    version: 1,
    id: "gallery-nav-item",
    parameters: ["icon", "label", "page"],
    root: NavItem(
        id: "item",
        label: "$label",
        icon: "$icon",
        read: Page(id: "/page", name: "$page"),
        write: Page(id: "/page", name: "$page"),
    ),
)
