(
    schema: "kithara.module",
    version: 1,
    id: "gallery-tree-tab",
    chrome: Plain,
    root: Row(
        size: (w: Fill, h: Fill),
        background: Bg,
        children: [
            Tree(
                id: "browser",
                size: (w: Fixed(232.0), h: Fill),
                read: Model(id: "library.tree"),
                write: Command(id: "library.select_tree_row"),
                query: Model(id: "library.query"),
                write_query: Model(id: "library.query"),
            ),
        ],
    ),
)
