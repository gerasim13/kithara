            Text(id: "semibold", style: Brand, font: "$family", weight: Semibold, label: "Kithara Deck 0123456789", size: (w: Fill, h: Fixed(20.0))),
            Text(id: "bold", style: Brand, font: "$family", weight: Bold, label: "Kithara Deck 0123456789", size: (w: Fill, h: Fixed(20.0))),
