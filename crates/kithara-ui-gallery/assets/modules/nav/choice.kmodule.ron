(
    schema: "kithara.module",
    version: 1,
    id: "gallery-nav-choice",
    parameters: ["icon", "label", "lit", "pick", "choice"],
    root: NavItem(
        id: "item",
        label: "$label",
        icon: "$icon",
        read: Model(id: "$lit"),
        write: Command(id: "$pick", with: { "choice": "$choice" }),
    ),
)
