(
    schema: "kithara.module",
    version: 1,
    id: "gallery-module-deck-micro",
    title: Some("Micro deck"),
    chip: Some("MIC"),
    chrome: Full,
    collapse: Some(Command(id: "gallery.module.collapse", with: { "module": "gallery-module-deck-micro" })),
    footer: Some(Model(id: "gallery.footer.deck_micro")),
    root: Column(
        children: [
            Slot(
                id: "content",
                size: (w: Fill, h: Fill),
                default: [
                    Include(
                        id: "deck-micro",
                        source: "deck-micro.kmodule.ron",
                        with: { "deck": "a" },
                    ),
                ],
            ),
        ],
    ),
)
