(
    schema: "kithara.module",
    version: 1,
    id: "gallery-toggles",
    root: Column(
        size: (w: Fill, h: Shrink),
        gap: Some(8.0),
        children: [
            Text(id: "title", style: Section, read: Model(id: "gallery.label.toggles")),
            Row(
                size: (w: Fill, h: Shrink),
                gap: Some(12.0),
                children: [
                    Toggle(id: "toggle-on", read: Model(id: "demo.toggle.on"), write: Command(id: "demo.toggle.toggle_on")),
                    Toggle(id: "toggle-off", read: Model(id: "demo.toggle.off"), write: Command(id: "demo.toggle.toggle_off")),
                    Checkbox(id: "checkbox-on", read: Model(id: "demo.checkbox.on"), write: Command(id: "demo.checkbox.toggle_on")),
                    Checkbox(id: "checkbox-off", read: Model(id: "demo.checkbox.off"), write: Command(id: "demo.checkbox.toggle_off")),
                ],
            ),
        ],
    ),
)
