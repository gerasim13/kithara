CACHE_CONFIG_VOLUME=/Volumes/KitharaCI/services/ci-cache/config
CACHE_DATA_VOLUME=/Volumes/KitharaCI/services/ci-cache/data
CACHE_CLIENTS_VOLUME=/Volumes/KitharaCI/services/ci-cache/clients
CACHE_NETWORK=kithara-ci-cache
CACHE_SCOPES="trusted review quarantine"
CACHE_BUCKET_QUOTA=20GiB
CACHE_CLIENT_ENDPOINT=http://127.0.0.1:19000
CACHE_CLIENT_UID=503
CACHE_PORT=19000
